generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id         Int       @id @default(autoincrement())
  username   String    @db.VarChar(50)
  email      String    @unique(map: "email") @db.VarChar(255)
  password   String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  role       Role      @default(user)
  coins      Int       @default(0)

  card                   Card?
  collection             UserCard[]
  booster                UserBooster?
  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")
  reportsMade            Report[]     @relation("ReportReporter")
  reportsReceived        Report[]     @relation("ReportReportedUser")
  initiatedTrades        Trade[]      @relation("TradeInitiator")
  receivedTrades         Trade[]      @relation("TradePartner")
  tradesToAnswer         Trade[]      @relation("TradeTurnUser")
  givenTradeItems        TradeItem[]  @relation("TradeItemGiver")

  @@map("users")
}

model Card {
  id                  Int        @id @default(autoincrement())
  name                String     @db.VarChar(100)
  position_collection Int        @default(0)
  subtitle            String?    @db.VarChar(255)
  description         String?    @db.VarChar(500)
  image               String?    @db.VarChar(255)
  hp                  Int?
  color               String?    @db.VarChar(7)
  rarity              Rarity
  type                CardType
  created_by          Int?       @unique(map: "created_by")
  avatar              Json?
  status              CardStatus @default(approved)
  talent              Talent?

  creator    User?        @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cards_user")
  attacks    CardAttack[]
  owners     UserCard[]
  reports    Report[]
  tradeItems TradeItem[]

  @@map("cards")
}

model CardAttack {
  id          Int        @id @default(autoincrement())
  card_id     Int
  slot        Int        @db.TinyInt
  name        String     @db.VarChar(100)
  kind        AttackKind @default(attack)
  energy_cost Int        @db.TinyInt
  damage      Int
  description String?    @db.VarChar(255)

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "card_attacks_ibfk_1")

  @@unique([card_id, slot], map: "uniq_card_slot")
  @@map("card_attacks")
}

model UserCard {
  user_id     Int
  card_id     Int
  quantity    Int       @default(1)
  obtained_at DateTime? @default(now()) @db.Timestamp(0)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_cards_ibfk_1")
  card Card @relation(fields: [card_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_cards_ibfk_2")

  @@id([user_id, card_id])
  @@index([card_id], map: "card_id")
  @@map("user_cards")
}

model UserBooster {
  user_id        Int    @id
  stored_booster Int
  last_gained_at BigInt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_boosters_user_fk")

  @@map("user_boosters")
}

model Friendship {
  id           Int              @id @default(autoincrement())
  requester_id Int
  addressee_id Int
  status       FriendshipStatus @default(pending)
  created_at   DateTime?        @default(now()) @db.Timestamp(0)
  user_low     Int
  user_high    Int

  requester User @relation("FriendshipRequester", fields: [requester_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "friendships_ibfk_1")
  addressee User @relation("FriendshipAddressee", fields: [addressee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "friendships_ibfk_2")

  @@unique([user_low, user_high], name: "pair", map: "uniq_pair")
  @@index([addressee_id], map: "addressee_id")
  @@index([requester_id], map: "requester_id")
  @@map("friendships")
}

model Report {
  id               Int          @id @default(autoincrement())
  reporter_id      Int
  reported_user_id Int?
  card_id          Int?
  reason           ReportReason
  message          String?      @db.VarChar(500)
  created_at       DateTime?    @default(now()) @db.Timestamp(0)

  card         Card? @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reports_ibfk_1")
  reporter     User  @relation("ReportReporter", fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reports_ibfk_2")
  reportedUser User? @relation("ReportReportedUser", fields: [reported_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reports_ibfk_3")

  @@unique([reporter_id, card_id], map: "uniq_repoter_card")
  @@unique([reporter_id, reported_user_id], map: "uniq_repoter_user")
  @@index([card_id], map: "card_id")
  @@index([reported_user_id], map: "reported_user_id")
  @@map("reports")
}

model Trade {
  id              Int         @id @default(autoincrement())
  initiator_id    Int
  partner_id      Int
  turn_user_id    Int
  initiator_coins Int         @default(0)
  partner_coins   Int         @default(0)
  status          TradeStatus @default(pending)
  created_at      DateTime    @default(now()) @db.Timestamp(0)
  updated_at      DateTime    @updatedAt @db.Timestamp(0)

  initiator User        @relation("TradeInitiator", fields: [initiator_id], references: [id], onDelete: Cascade)
  partner   User        @relation("TradePartner", fields: [partner_id], references: [id], onDelete: Cascade)
  turnUser  User        @relation("TradeTurnUser", fields: [turn_user_id], references: [id], onDelete: Cascade)
  items     TradeItem[]

  @@index([initiator_id])
  @@index([partner_id])
  @@index([turn_user_id])
  @@map("trades")
}

model TradeItem {
  id       Int @id @default(autoincrement())
  trade_id Int
  giver_id Int
  card_id  Int
  quantity Int @default(1)

  trade Trade @relation(fields: [trade_id], references: [id], onDelete: Cascade)
  giver User  @relation("TradeItemGiver", fields: [giver_id], references: [id], onDelete: Cascade)
  card  Card  @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([trade_id, giver_id, card_id])
  @@index([giver_id])
  @@index([card_id])
  @@map("trade_items")
}

enum Role {
  user
  admin
}

enum Rarity {
  common
  uncommon
  rare
  epic
  legendary
}

enum CardType {
  collection
  battle
  student
}

enum CardStatus {
  pending
  approved
  rejected
}

enum AttackKind {
  attack
  defense
}

enum FriendshipStatus {
  pending
  accepted
}

enum ReportReason {
  inappropriate
  offensive
  harassment
  impersonation
  spam
  other
}

enum Talent {
  striker
  guardian
  energizer
}

enum TradeStatus {
  pending
  accepted
  declined
  cancelled
}
